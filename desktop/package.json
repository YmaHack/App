{
  "name": "daily-challenge-desktop",
  "version": "1.0.3",
  "description": "אתגר יומי — תוכנת מחשב עם סנכרון לאפליקציית Android",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "npm run prebuild && electron-builder --win",
    "prebuild": "node make-icon.cjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "sharp": "0.33.5",
    "png-to-ico": "2.1.8"
  },
  "build": {
    "appId": "com.ymahack.dailychallenge.desktop",
    "productName": "אתגר יומי",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "phone-logo.svg",
      "scene-mountain.svg",
      "scene-forest.svg",
      "scene-sea.svg",
      "icon.ico",
      "installer.nsh",
      "make-icon.cjs"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer.nsh"
    },
    "icon": "icon.ico"
  }
}
